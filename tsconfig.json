{
	"compilerOptions": {
		"strict": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noImplicitThis": true,
		"paths": {
			"@/*": ["./*"]
		},
		"target": "es2017",
		"declaration": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"types": ["node"],
		"rootDir": "src",
		"outDir": "lib"
	},

	"files": ["src/index.ts", "src/display-entry.ts"]
}
