{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"strict": true,
		"strictNullChecks": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"lib": ["ES2021", "DOM"],
		"rootDir": ".",
		"types": ["node", "vitest/globals"],
		"allowImportingTsExtensions": true
	},
	"files": [],
	"include": ["tests/**/*.ts", "vitest.config.mts"],
	"exclude": ["tests/types/**"]
}
