{
  "name": "rot-js",
  "version": "2.2.1",
  "description": "A roguelike toolkit in JavaScript",
  "keywords": [
    "ascii",
    "dungeon",
    "fov",
    "game",
    "libtcod",
    "lighting",
    "los",
    "rng",
    "rogue",
    "roguelike",
    "tiles"
  ],
  "files": [
    "lib",
    "dist",
    "doc",
    "examples",
    "addons",
    "manual"
  ],
  "homepage": "https://ondras.github.io/rot.js",
  "bugs": "https://github.com/ondras/rot.js/issues",
  "license": "BSD-3-Clause",
  "author": "Ondřej Žára <ondrej.zara@gmail.com> (https://ondras.zarovi.cz/)",
  "main": "dist/rot.js",
  "module": "lib/index.js",
  "scripts": {
    "clean": "node scripts/clean.js",
    "typecheck": "tsc --project tsconfig.json",
    "typecheck:tests": "tsc --project tsconfig.tests.json",
    "bundle": "rollup --config rollup.config.mjs",
    "docs": "typedoc --out doc --readme none --excludePrivate --excludeProtected --validation.invalidLink --name \"rot.js\" src/index.ts",
    "build": "npm run clean && npm run typecheck && npm run bundle && npm run docs",
    "test": "npm run typecheck && npm run typecheck:tests && vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ondras/rot.js.git"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@napi-rs/canvas": "^1.1.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "rollup": "^4.68.5",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "types": "./lib/index.d.ts"
}
