{
  "name": "rot-next.js",
  "version": "2.2.1",
  "description": "A modernized roguelike toolkit in JavaScript and TypeScript, based on rot.js",
  "keywords": [
    "ascii",
    "dungeon",
    "fov",
    "game",
    "libtcod",
    "lighting",
    "los",
    "rng",
    "rogue",
    "roguelike",
    "tiles"
  ],
  "type": "module",
  "files": [
    "lib",
    "dist",
    "license.txt"
  ],
  "homepage": "https://github.com/LeapInSoft/rot-next.js",
  "bugs": "https://github.com/LeapInSoft/rot-next.js/issues",
  "license": "BSD-3-Clause",
  "author": "LeapInSoft",
  "contributors": [
    "Ondřej Žára <ondrej.zara@gmail.com> (original author of rot.js; https://ondras.zarovi.cz/)"
  ],
  "main": "./dist/rot.cjs",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./dist/rot.cjs"
    },
    "./display": {
      "types": "./lib/display-entry.d.ts",
      "import": "./lib/display-entry.js",
      "require": "./dist/display.cjs"
    },
    "./addons/*.js": {
      "types": "./lib/addons/*.d.ts",
      "import": "./lib/addons/*.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean.cjs",
    "build": "npm run typecheck && npm run bundle && npm run addons:build && npm run docs",
    "typecheck": "tsc --project tsconfig.json && node scripts/resolve-paths.cjs",
    "typecheck:tests": "tsc --project tsconfig.tests.json",
    "typecheck:consumer": "npm run typecheck && npm run addons:build && tsc --project tests/types/tsconfig.json --noEmit && tsc --project tests/types/display-tsconfig.json --noEmit",
    "lint": "eslint .",
    "bundle": "rollup --config rollup.config.mjs",
    "docs": "typedoc --out doc --readme none --excludePrivate --excludeProtected --validation.invalidLink --name \"rot-next.js\" src/index.ts",
    "prepack": "npm run build",
    "test:prepare": "npm run clean && npm run typecheck && npm run bundle && npm run addons:build && npm run examples:bundle",
    "pretest": "npm run test:prepare",
    "test": "npm run typecheck:tests && npm run typecheck:consumer && vitest run",
    "test:examples": "npm run test:prepare && vitest run tests/exemples",
    "build:examples": "npm run typecheck && rollup --config examples/bundled-modules/rollup.config.mjs",
    "addons:build": "tsc --project tsconfig.addons.json",
    "examples:serve": "http-server . -p 8080 -c-1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LeapInSoft/rot-next.js.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.1.1",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "http-server": "^14.1.1",
    "rollup": "^4.68.5",
    "typedoc": "^0.23.25",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.12"
  }
}
