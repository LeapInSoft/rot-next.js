{
  "name": "rot-next.js",
  "version": "2.2.1",
  "description": "A modernized roguelike toolkit in JavaScript and TypeScript, based on rot.js",
  "keywords": [
    "ascii",
    "dungeon",
    "fov",
    "game",
    "libtcod",
    "lighting",
    "los",
    "rng",
    "rogue",
    "roguelike",
    "tiles"
  ],
  "files": [
    "lib",
    "dist",
    "doc",
    "examples",
    "addons",
    "manual",
    "license.txt"
  ],
  "homepage": "https://github.com/LeapInSoft/rot-next.js",
  "bugs": "https://github.com/LeapInSoft/rot-next.js/issues",
  "license": "BSD-3-Clause",
  "author": "LeapInSoft",
  "contributors": [
    "Ondřej Žára <ondrej.zara@gmail.com> (original author of rot.js; https://ondras.zarovi.cz/)"
  ],
  "main": "dist/rot.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "clean": "node scripts/clean.js",
    "typecheck": "tsc --project tsconfig.json && node scripts/resolve-paths.cjs",
    "typecheck:tests": "tsc --project tsconfig.tests.json",
    "lint": "eslint src tests",
    "bundle": "rollup --config rollup.config.mjs",
    "docs": "typedoc --out doc --readme none --excludePrivate --excludeProtected --validation.invalidLink --name \"rot.js\" src/index.ts",
    "build": "npm run clean && npm run typecheck && npm run bundle && npm run docs",
    "test": "tsc --project tsconfig.json --noEmit && npm run typecheck:tests && vitest run",
    "test:examples": "npm run typecheck && npm run bundle && vitest run tests/exemples",
    "examples:bundle": "npm run typecheck && rollup --config examples/bundled-modules/rollup.config.mjs",
    "examples:serve": "http-server . -p 8080 -c-1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LeapInSoft/rot-next.js.git"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@napi-rs/canvas": "^1.1.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "happy-dom": "^21.0.4",
    "http-server": "^14.1.1",
    "rollup": "^4.68.5",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
