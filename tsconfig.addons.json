{
	"compilerOptions": {
		"strict": true,
		"target": "es2017",
		"module": "es2022",
		"moduleResolution": "bundler",
		"rootDir": "addons",
		"outDir": "lib/addons",
		"declaration": true,
		"noEmit": false
	},
	"include": [
		"addons/core/**/*.ts",
		"addons/combat/**/*.ts",
		"addons/entities/**/*.ts",
		"addons/pubsub/**/*.ts",
		"addons/text/**/*.ts",
		"addons/turns/**/*.ts",
		"addons/game/**/*.ts",
		"addons/items/**/*.ts",
		"addons/backpack/**/*.ts",
		"addons/equipment/**/*.ts",
		"addons/game_state/**/*.ts"
	]
}
